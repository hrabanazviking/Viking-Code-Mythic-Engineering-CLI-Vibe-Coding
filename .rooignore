# Roo context boundaries for Mythic Vibe CLI

# Keep Roo focused on the active product, not dormant imported islands.
ai/
core/
systems/
sessions/
yggdrasil/
imports/
mindspark_thoughtform/
ollama/
whisper/
chatterbox/
WYRD-Protocol-*/

# Ignore generated and dependency-heavy paths.
node_modules/
__pycache__/
*.exe
*.dll
.git/
.venv/
venv/
dist/
build/
target/

# Protect your secrets
.env
secrets.json
*.pem
